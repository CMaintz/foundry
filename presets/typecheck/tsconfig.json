// Foundry TypeScript preset: a strict, check-only tsconfig for `mise run typecheck`.
// foundry-init copies it to <working_dir>/tsconfig.json for the `ts` stack (it never
// overwrites an existing one).
//
// On a framework, extend the framework's strict preset instead and keep `include`:
//   Astro  "extends": "astro/tsconfigs/strict"   (typecheck: astro check)
//   Vite   "extends": "@tsconfig/vite-react/tsconfig.json" or similar
// Without a tsconfig, `astro check` / `vue-tsc` / `svelte-check` still exit 0, but they
// check only their own file types with loose defaults, so plain .ts files and tests
// are never type-checked.
//
// `include` must cover every TypeScript file you ship or run: source, build scripts,
// config files, AND tests. A file outside it is only checked if something included
// imports it.
//
// Deno code (e.g. supabase/functions) does NOT belong here: it has its own globals
// (`Deno.*`) and `npm:`/`jsr:`/URL imports. Keep it out of `include` and check it with
// `deno check` (FOUNDRY_DENO_PATHS in the mise template).
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "scripts", "test", "tests", "*.ts", "*.mts"],
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
