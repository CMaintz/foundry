<Project>
  <!-- Foundry .NET structural-analysis scaffold. foundry-init copies this to the
       consumer repo root; MSBuild auto-imports the nearest Directory.Build.props
       walking up from each .csproj, so every project in the solution inherits it.

       The SonarAnalyzer.CSharp reference below is what the habit-hooks `dotnet` sensor's
       build needs present: the sensor runs `dotnet build` with its own ruleset enabling the
       structural rules (method length, cyclomatic/cognitive complexity, too many parameters,
       file size), reads the warnings and ratchets them against the snooze baseline. The
       built-in .NET analyzers stay on for `typecheck` (`dotnet build -warnaserror`), which
       owns compile errors, the CA rules and NuGetAudit. The sensor gates the five structural
       rules instead; they are also demoted to `suggestion` in the sibling .editorconfig.
       Tune rule severities there, not here. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <!-- Scoped to the sensor's own build: the reference loads only when CodeAnalysisRuleSet
       is set, which the habit-hooks dotnet sensor sets and typecheck does not. So typecheck
       (`dotnet build -warnaserror`, no ruleset) never loads SonarAnalyzer and its rules
       cannot flood the build. This keeps the preset safe even in a strict repo that drops
       the bulk `dotnet_analyzer_diagnostic.severity = suggestion` line from its .editorconfig
       (where an unconditional reference would turn ~40 default-on Sonar rules into errors). -->
  <ItemGroup Condition="'$(CodeAnalysisRuleSet)' != ''">
    <!-- Pinned; Renovate's nuget manager tracks this PackageReference. PrivateAssets=all
         keeps the analyzer a build-time dev dependency - it never flows to consumers of
         the built package. -->
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>
</Project>
