# Foundry .NET structural-smell defaults. foundry-init copies this to the consumer
# repo root alongside Directory.Build.props. Override per-project by editing this file.
#
# Severities ONLY. `lint` runs `dotnet format --verify-no-changes`, which also reads
# .editorconfig, so adding any formatting option here (indent_style, end_of_line,
# csharp_* style rules) would turn into an instant lint failure in every consumer.
# Keep style preferences in a separate, consumer-owned .editorconfig section.
#
# How this is shaped: the bulk line below dials the whole analyzer set (SonarAnalyzer
# + the built-in CA/IDE rules) down to `suggestion` so the default gate is focused, not
# a flood. The five structural-smell rules below are KEPT at `suggestion` deliberately
# (they are listed, not silenced, so a project can see and retune them): the habit-hooks
# `dotnet` sensor owns them. The sensor builds with its own ruleset that enables them as
# warnings and ratchets them against the snooze baseline, so an existing backlog is
# grandfathered and only new structural debt gates - which a blanket `-warnaserror` cannot
# do. `suggestion` here means `typecheck` (`dotnet build -warnaserror`, no ruleset) does NOT
# hard-fail them, so they are not double-gated. (Empirically verified: the sensor's
# `-p:CodeAnalysisRuleSet` overrides this `suggestion` severity in the sensor's own build, so
# the finding still fires there; typecheck, reading only this file, stays green on them.)
#
# typecheck still keeps its teeth on everything else: compiler warnings (CS8xxx nullable),
# the built-in CA rules and NuGetAudit (NU19xx) are not demoted by the bulk line (see the
# NOTE below), so `-warnaserror` still fails on them.
#
# NOTE: the bulk `suggestion` line covers only analyzer diagnostics. Compiler warnings
# (CS8xxx nullable) and NuGetAudit (NU19xx vulnerability) warnings are NOT analyzer
# diagnostics, so they keep their teeth under -warnaserror regardless of this file.
# Smell thresholds (S138 ~80 lines, S107 7 params, S3776 cognitive 15, S1541
# cyclomatic 10, S104 1000 lines/file) use SonarAnalyzer's defaults; they are not tunable
# from .editorconfig - a SonarLint.xml AdditionalFile would be needed to change them.
#
# NOTE on class size: S1448 ("too many methods") is a Java-only Sonar rule; sonar-dotnet
# ships no C# equivalent, so it is a silent no-op in a C# build. S104 (too many lines in a
# file) is the nearest C# class-size smell - in idiomatic one-type-per-file C# a too-large
# file is a too-large type - so it stands in for class size here.

root = true

[*.cs]
# Everything defaults to a non-blocking suggestion ...
dotnet_analyzer_diagnostic.severity = suggestion

# ... and the five structural smells stay at `suggestion`: the habit-hooks dotnet sensor
# owns them (ratcheted), so typecheck must not hard-fail them under -warnaserror:
dotnet_diagnostic.S138.severity = suggestion   # method/function too long (oversized-function)
dotnet_diagnostic.S1541.severity = suggestion  # cyclomatic complexity too high (high-complexity)
dotnet_diagnostic.S3776.severity = suggestion  # cognitive complexity too high (high-complexity)
dotnet_diagnostic.S107.severity = suggestion   # too many parameters (too-many-parameters)
dotnet_diagnostic.S104.severity = suggestion   # too many lines in a file (oversized-file)
