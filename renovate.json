{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>CMaintz/foundry//presets/renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "osv-scanner version pinned as a default in the reusable workflows",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["osv_scanner_version:[\\s\\S]*?default:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "google/osv-scanner",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "PMD version pinned as a default in the reusable workflows",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["pmd_version:[\\s\\S]*?default:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "pmd/pmd",
      "extractVersionTemplate": "^pmd_releases/(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "mise CLI version pinned as a default in the reusable workflows",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["mise_version:[\\s\\S]*?default:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "habit-hooks version pinned as a default in the reusable workflows (core and plugins release in lockstep)",
      "fileMatch": ["^\\.github/workflows/.*\\.ya?ml$"],
      "matchStrings": ["habit_hooks_version:[\\s\\S]*?default:\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "habit-hooks"
    },
    {
      "customType": "regex",
      "description": "habit-hooks version pinned in the mise templates / consumer mise.toml (HABIT_HOOKS_VERSION); core + plugin release in lockstep, so one bump covers both",
      "fileMatch": ["(^|/)mise.*\\.toml$"],
      "matchStrings": ["HABIT_HOOKS_VERSION\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "habit-hooks"
    }
  ]
}
